├── widgets/                          ← Components dùng chung
│   ├── bottom_nav_shell.dart         ← Bottom navigation bar
│   ├── gradient_header.dart          ← Header gradient cam
│   ├── service_icon_card.dart        ← Icon dịch vụ
│   └── tasker_card.dart              ← Card tasker
├── screens/                          ← 15 màn hình
│   ├── trang_chu/
│   │   └── trang_chu_screen.dart
│   ├── dang_nhap/
│   │   └── dang_nhap_screen.dart
│   ├── quen_mat_khau/
│   │   └── quen_mat_khau_screen.dart
│   ├── dat_dich_vu/
│   │   ├── don_nha_screen.dart
│   │   ├── trong_tre_screen.dart
│   │   └── mua_ho_screen.dart
│   ├── goi_gia_dinh/
│   │   └── goi_gia_dinh_screen.dart
│   ├── theo_doi_don/
│   │   └── theo_doi_don_screen.dart
│   ├── lich_su/
│   │   ├── hoat_dong_screen.dart
│   │   └── vi_screen.dart
│   ├── chat/
│   │   └── chat_screen.dart
│   ├── danh_gia/
│   │   └── danh_gia_screen.dart
